#!/usr/bin/env bash
# Pre-commit: format checks + clippy. Heavy checks (tests, coverage) run in pre-push.
# Bypass: git commit --no-verify
set -eo pipefail

R='\033[0;31m' G='\033[0;32m' Y='\033[1;33m' B='\033[0;34m' N='\033[0m'
FAILED=false

fmt() {
    local label=$1 tool=$2 fix=$3; shift 3
    [[ -n "$tool" ]] && ! command -v "$tool" &>/dev/null && { echo -e "${Y}⚠ $tool not found, skipping${N}"; return; }
    echo -e "\n${Y}$label...${N}"
    "$@" && echo -e "${G}✓ $label${N}" || { echo -e "${R}✗ $label. $fix${N}"; FAILED=true; }
}

# Ensure generated baml_client stub exists so cargo fmt doesn't fail
mkdir -p crates/crux-agentic/src/baml_client
[[ -f crates/crux-agentic/src/baml_client/mod.rs ]] || touch crates/crux-agentic/src/baml_client/mod.rs

# Guard against accidental cross-directory staging
if [[ -n "$GIT_PREFIX" ]]; then
    SUBDIR="${GIT_PREFIX%/}"
    OUTSIDE=$(git diff --cached --name-only | grep -v "^$(printf '%s' "$SUBDIR" | sed 's/[[\.*^$/]/\\&/g')/" || true)
    if [[ -n "$OUTSIDE" ]]; then
        echo -e "${R}ERROR: Staged changes outside $SUBDIR/:${N}"
        echo "$OUTSIDE" | head -10
        [[ $(echo "$OUTSIDE" | wc -l) -gt 10 ]] && echo "... and more"
        echo -e "${Y}Use 'git add .' or commit from repo root. Pass --no-verify to override.${N}"
        exit 1
    fi
fi

STAGED=$(git diff --cached --name-only --diff-filter=d)
[[ -z "$STAGED" ]] && { echo -e "${G}✓ No staged files${N}"; exit 0; }

RS=() SH=() YAML=() MD=() DOCKER=() DC=() HAS_TF=false
while IFS= read -r f; do
    case "$f" in
        *.rs)                      RS+=("$f") ;;
        *.tf)                      HAS_TF=true ;;
        *.sh)                      SH+=("$f") ;;
        *.yaml|*.yml)              YAML+=("$f") ;;
        *.md)                      MD+=("$f") ;;
        *Dockerfile*|*dockerfile*) DOCKER+=("$f") ;;
        *devcontainer*.json)       DC+=("$f") ;;
    esac
done <<< "$STAGED"

echo -e "${B}Running pre-commit checks...${N}"

[[ ${#RS[@]}     -gt 0 ]] && fmt "Rust fmt"         ""        "cargo fmt --all"                              cargo fmt --all -- --check
[[ "$HAS_TF" == true  ]] && fmt "Terraform fmt"    terraform  "terraform fmt -recursive infrastructure/terraform/" terraform fmt -check -recursive infrastructure/terraform/
[[ ${#SH[@]}     -gt 0 ]] && fmt "Shell fmt"        shfmt     "shfmt -w -i 4 -bn <file>"                    shfmt -d -i 4 -bn "${SH[@]}"
[[ ${#YAML[@]}   -gt 0 ]] && fmt "YAML fmt"         prettier  "prettier --write <file>"                      prettier --check --parser=yaml "${YAML[@]}"
[[ ${#MD[@]}     -gt 0 ]] && fmt "Markdown fmt"     prettier  "prettier --write <file>"                      prettier --check --parser=markdown "${MD[@]}"
[[ ${#DOCKER[@]} -gt 0 ]] && fmt "Dockerfile lint"  hadolint  "Fix hadolint warnings."                       hadolint "${DOCKER[@]}"

if [[ ${#DC[@]} -gt 0 ]]; then
    echo -e "\n${Y}Devcontainer JSON...${N}"
    DC_OK=true
    for f in "${DC[@]}"; do
        [[ -f "$f" ]] && ! sed 's|//.*||; /\/\*/,/\*\//d' "$f" | jq empty 2>/dev/null && { echo -e "${R}✗ Invalid JSON: $f${N}"; DC_OK=false; }
    done
    $DC_OK && echo -e "${G}✓ Devcontainer JSON${N}" || FAILED=true
fi

[[ ${#RS[@]} -gt 0 ]] && fmt "Clippy" "" "cargo clippy --all-targets -- -D warnings" cargo clippy --all-targets -- -D warnings

echo ""
[[ "$FAILED" == true ]] && { echo -e "${R}✗ Pre-commit checks failed${N}"; exit 1; }
echo -e "${G}✓ All pre-commit checks passed!${N}"
