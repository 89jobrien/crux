# crux environment variables
# Copy to .env and fill in values, or use dotenvx for encrypted secrets.
#
# Usage with dotenvx:
#   dotenvx set OPENAI_API_KEY "sk-..."
#   dotenvx run -- crux run examples/extract_entities.yaml examples/input_entities.json
#
# Usage with 1Password + dotenvx (see CLAUDE.local.md):
#   DOTENV_PRIVATE_KEY=$(op read "op://...") dotenvx run -- crux plan --goal "..."

# LLM providers (at least one required for llm::complete, llm::extract, plan)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
