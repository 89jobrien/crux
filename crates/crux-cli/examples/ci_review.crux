pipeline: ci_review
description: CI/review workflow with parallel validation stages
input_schema:
  type: object
  properties:
    branch:
      type: string
    repository:
      type: string
  required:
    - branch
    - repository

budget:
  calls: 20
  duration_ms: 180000
  steps: 10

display:
  title: "CI Review Pipeline"
  output: auto

steps:
  - step: checkout_branch
    handler: ci::checkout
    args:
      branch: "{{ input.branch }}"
      repo: "{{ input.repository }}"
    timeout_ms: 30000

  - step: parallel_checks
    join_all: "run_all_checks"
    arms:
      - step: lint_check
        handler: ci::lint
        allow_failure: true

      - step: test_check
        handler: ci::test
        allow_failure: true

      - step: build_check
        handler: ci::build
        allow_failure: true

  - step: analyze_results
    handler: ci::analyze
    args:
      branch: "{{ input.branch }}"
      lint_result: "{{ steps.lint_check }}"
      test_result: "{{ steps.test_check }}"
      build_result: "{{ steps.build_check }}"

  - step: summary
    handler: ci::report
    args:
      results: "{{ steps.analyze_results }}"
