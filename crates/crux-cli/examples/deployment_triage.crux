pipeline: deployment_triage
description: Deployment validation and issue triage — fetch manifest, check services, classify results
input_schema:
  type: object
  properties:
    deployment_id:
      type: string
    target_env:
      type: string
      enum: ["dev", "staging", "production"]
    manifest_path:
      type: string
  required:
    - deployment_id
    - target_env
    - manifest_path

budget:
  steps: 12
  duration_ms: 300000

vars:
  deployment_name: "{{ input.target_env }}_{{ input.deployment_id }}"

steps:
  - step: fetch_manifest
    handler: fs::read
    args:
      path: "{{ input.manifest_path }}"
    timeout_ms: 10000
    retry:
      count: 2
      delay_ms: 2000

  - step: parse_services
    handler: json::jq
    args:
      expr: ".services"

  - step: filter_active_services
    handler: json::filter_nonempty
    args:
      field: "name"

  - step: for_each_service
    for_each: "check_service as service"
    items: "{{ steps.filter_active_services }}"
    steps:
      - step: log_service
        handler: ctrl::log
        args:
          field: "name"
          compact: true

  - step: classify_results
    handler: triage::classify_severity

  - step: report_results
    handler: ctrl::log
    args:
      pretty: true
