name: "crux-verify";
version: "0.1.0";
description: "Formal verification proofs for crux trace invariants";
functions {
  pord_trans : pord'(a, b) & pord'(b, c) -> pord'(a, c);
  consume_mono : true -> pord'(remaining'(consume'(s)), remaining'(s));
  step_mono : true -> pord'(remaining'(begin_step'(s)), remaining'(s));
  two_consume_mono : true -> pord'(remaining'(consume'(consume'(s))), remaining'(s));
}
dependencies {
}
