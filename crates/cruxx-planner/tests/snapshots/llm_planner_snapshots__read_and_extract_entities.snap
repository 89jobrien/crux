---
pipeline: extract_entities
steps:
  - step: read
    handler: fs::read
    path: input.txt
  - step: extract
    handler: llm::extract
    function: ExtractEntities
    input: "$step:read"
  - step: write
    handler: json::write
    content: "$step:extract"
    path: output.json
