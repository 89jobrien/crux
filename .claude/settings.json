{
  "permissions": {
    "allow": [
      "Bash(bash:*)",
      "Bash(nu:*)",
      "Write",
      "Update",
      "Read",
      "Glob",
      "Search",
      "Agent",
      "WebFetch",
      "Bash(echo:*)",
      "Bash(uv:*)",
      "Bash(devloop:*)",
      "Bash(cruxx:*)",
      "Bash(devkit:*)",
      "Bash(baml-cli:*)",
      "Bash(head:*)",
      "Bash(xargs:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "nu .claude/hooks/session-start-lock-check.nu",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "nu .claude/hooks/no-raw-cargo.nu",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "nu .claude/hooks/protocol-drift-check.nu",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "nu .claude/hooks/propagation-check.nu",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "nu .claude/hooks/cargo-toml-propagation-check.nu",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
