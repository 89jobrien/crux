pipeline: enrich_classify
# Input: { function: "ClassifyProject", input: { name, description, language, topics, commits } }
# Output: { category: "...", confidence: 0.0 }
budget: { calls: 2 }

steps:
  - step: classify
    handler: llm::extract
    args:
      function: ClassifyProject

  - step: log
    handler: ctrl::log
