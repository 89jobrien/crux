pipeline: extract_summary
# Read a source file, summarize it via BAML, and write structured JSON output.
#
# Pipeline input (pass as input.json to cruxx-run):
#   {
#     "function": "Summarize",
#     "input": { "text": "<text to summarize>", "max_sentences": 5 },
#     "output_path": "summary_out.json"
#   }
#
# Environment — set one of:
#   ANTHROPIC_API_KEY   (BAML uses Claude by default)
#   OPENAI_API_KEY      (configure client override in BAML client config)
#
# Run:
#   cruxx-run examples/extract_summary.yaml examples/input_summary.json
budget: { calls: 2 }

steps:
  - step: summarize
    handler: llm::extract
    # Input shape: { function: "Summarize", input: { text: "...", max_sentences: N } }
    # Output:      { summary: "...", key_points: ["..."], word_count: N }

  - step: write_output
    handler: ctrl::log
    # Logs the structured summary to stderr and passes it through as the
    # pipeline output. Capture it from cruxx-run's "Output:" section or
    # redirect stdout to a file:
    #   cruxx-run examples/extract_summary.yaml examples/input_summary.json \
    #     | tail -n +$(cruxx-run ... | grep -n "^Output:" | cut -d: -f1) \
    #     > summary_out.json
    #
    # For a direct write, replace ctrl::log with fs::write and provide
    # a `content` field (JSON-serialized string) in the pipeline input.
