pipeline: dep_audit
# Dependency health audit across a Rust workspace. Checks for outdated deps,
# security advisories, license violations, and duplicate transitive deps.
# Produces a prioritized remediation plan.
budget: { calls: 8 }

steps:
  # Gather all cargo-deny output in one shell invocation so the parser
  # receives a single stdout covering advisories, licenses, and bans.
  - step: gather_deny
    handler: shell::capture
    args:
      cmd: "{ cargo deny check advisories 2>&1; cargo deny check licenses 2>&1; cargo deny check bans 2>&1; } || true"

  - pipe: analyze
    stages:
      - step: parse_deny
        handler: ci::deny_violations
        # Parse cargo-deny stdout into structured findings
      - step: classify
        handler: ci::classify_severity
        # advisories > bans > licenses > outdated
      - step: score
        handler: ci::score_fixability
        # Are these simple version bumps or breaking changes?

  - route_on_confidence: action
    value: "{{ steps.analyze.confidence }}"
    routes:
      - range: "[0.0, 0.3)"
        label: critical
        handler: ctrl::log
        # Active RUSTSEC advisory -- must patch immediately
      - range: "[0.3, 0.7)"
        label: maintenance
        handler: ctrl::log
        # Outdated deps or license issues -- schedule for next sprint
      - range: "[0.7, 1.0]"
        label: healthy
        handler: ctrl::log
        # Dep tree is clean -- no action needed
