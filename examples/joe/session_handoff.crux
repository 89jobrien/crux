pipeline: session_handoff
# Session start orientation pipeline. Accepts pre-scanned workspace data as
# input (dirty repos, handoffs, todos, worktrees, recent activity) and produces
# a prioritized session briefing.
#
# Dry run:  crux run examples/joe/session_handoff.crux examples/joe/input_session_handoff.json
# Live run: nu examples/joe/session_handoff_scan.nu
budget: { tokens: 6000, calls: 15 }

steps:
  - step: reshape
    handler: json::merge
    args:
      with:
        todos: "{{ input.pending_todos }}"
    # Bridge the scanner's `pending_todos` field into the `todos` shape the
    # triage handlers expect. Must be a top-level step, not a pipe stage:
    # pipe/join_all arm args are not template-expanded (only top-level
    # `step:` args go through expand_args), so this can't live inside the
    # `prioritize` pipe below.

  - pipe: prioritize
    stages:
      - step: parse_todos
        handler: triage::parse_repo_tags
        # Extract repo field from each todo
      - step: score
        handler: triage::score_urgency
        # Rank by age * priority weight
      - step: group
        handler: triage::group_by_repo
        # Partition into per-repo buckets. `triage::deduplicate_intent` is
        # skipped here: its `{groups: [...]}` output doesn't chain into
        # group_by_repo's `{todos: [...]}` input, so it can't sit between
        # score and group in a single sequential pipe.

  - step: assemble
    handler: json::merge
    args:
      with:
        dirty_repos: "{{ input.dirty_repos }}"
        handoffs: "{{ input.handoffs }}"
        stale_worktrees: "{{ input.stale_worktrees }}"
        recent_activity: "{{ input.recent_activity }}"
    # Recombine prioritized/grouped todos (steps.prioritize.output.repos)
    # with the raw context sections the triage pipe doesn't carry forward

  - step: emit_briefing
    handler: fs::write
    args:
      path: ".ctx/session-briefing.md"
      content: "{{ steps.assemble.output }}"
    # Write session briefing to .ctx/session-briefing.md:
    # - dirty repos needing attention
    # - stale worktrees to clean up
    # - top-priority pending items per repo
    # - recent 24h activity summary
