pipeline: doob_triage
# ASPIRATIONAL TEMPLATE — not all steps are implemented.
#
# Steps marked `handler: ctrl::noop` are design placeholders. They pass input
# through unchanged so the pipeline traces end-to-end but do no real work yet.
#
# Unimplemented arms and what they need:
#   parse_repo_tags       — extract the `repo` field from each doob JSON item.
#                           Implement as json::jq (dot-path) or a shell::capture
#                           wrapping `jq '.[] | .repo'`.
#   score_urgency         — compute age * priority weight per item. Can be a
#                           shell::capture + `jq` expression, or a Rust handler_value.
#   deduplicate_intent    — cluster semantically equivalent titles. Requires
#                           llm::invoke with a clustering prompt, or edit-distance
#                           heuristic in a Rust handler.
#   group_by_repo         — partition the scored list into per-repo buckets.
#                           Implement as json::jq grouping once filter support lands,
#                           or as a shell::capture + `jq 'group_by(.repo)'`.
#
# See docs/crux-capabilities.md — Known Gaps for current status.
#
# Process the pending doob backlog: score, deduplicate, and cluster by repo,
# then replace the delegate with a direct shell step for per-repo prioritization
# so each repo gets independent reasoning without bleeding token spend.
budget: { tokens: 8000 }

steps:
  - step: fetch_pending
    handler: shell::capture
    args:
      cmd: "doob todo list --status pending"
    # `doob todo list --status pending --json` — full pending list across repos

  - pipe: normalize
    stages:
      - step: parse_repo_tags
        handler: ctrl::noop
        # extract repo field from each todo's metadata
      - step: score_urgency
        handler: ctrl::noop
        # age * priority weight — older high-pri items score highest
      - step: deduplicate_intent
        handler: ctrl::noop
        # cluster todos whose titles are semantically equivalent
      - step: group_by_repo
        handler: ctrl::noop
        # partition into per-repo buckets for delegation

  # Replaced delegate(DoobRepoAgent) with a direct shell step.
  # Re-ranks within each repo bucket using doob todo update / git log recency signal.
  # Original budget was { tokens: 2000, calls: 10 } per repo bucket.
  - step: per_repo_prioritize
    handler: shell::capture
    args:
      cmd: "doob todo list --status pending"

  # Classify prioritization into a confidence score.
  # Reads per_repo_prioritize output and produces a confidence metric for routing.
  - step: classify_priority
    handler: llm::extract
    args:
      input: "{{ steps.per_repo_prioritize.output }}"
      function: Classify

  - route_on_confidence: schedule
    value: "{{ steps.classify_priority.confidence }}"
    routes:
      - range: "[0.0, 0.45)"
        label: ambiguous
        handler: ctrl::log
        # Print the ambiguous cluster to stdout for manual triage
      - range: "[0.45, 0.8)"
        label: scheduled
        handler: shell::capture
        args:
          cmd: "doob todo add --priority high"
        # `doob todo update --priority <new> <id>` for each item in ranked order
      - range: "[0.8, 1.0]"
        label: confident
        handler: shell::capture
        args:
          cmd: "doob todo list --status pending"
        # High confidence: also mark stale resolved items as done automatically
