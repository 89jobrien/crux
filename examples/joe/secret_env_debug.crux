pipeline: secret_env_debug
# Diagnose op:// resolution, direnv chain, and dotenvx injection issues.
# Walks the full secret injection path: 1Password -> direnv -> dotenvx -> env var.
budget: { calls: 10 }

steps:
  - join_all: probe_chain
    arms:
      - step: check_op_auth
        handler: shell::capture
        args:
          cmd: "op account list --format=json 2>&1 || true"
        # Is 1Password CLI authenticated and which account is active?
      - step: check_direnv
        handler: shell::capture
        args:
          cmd: "direnv status 2>&1 || true"
        # Is direnv loaded? Which .envrc is active?
      - step: check_dotenvx
        handler: shell::capture
        args:
          cmd: "dotenvx --version 2>&1 && echo DOTENV_PRIVATE_KEY=${DOTENV_PRIVATE_KEY:+set} || true"
        # Is dotenvx available and is the private key present?
      - step: check_env_vars
        handler: shell::capture
        args:
          cmd: "env | grep -iE 'ANTHROPIC|OPENAI|BAML|DOTENV' | sed 's/=.*/=<redacted>/' || true"
        # Which API key env vars are set (values redacted)?

  - pipe: diagnose
    stages:
      - step: parse_results
        handler: triage::parse_env_probe
        # Normalize probe outputs into structured findings
      - step: suggest_fixes
        handler: triage::suggest_remediation
        # Actionable fix commands for each failure class
      - step: classify_failures
        handler: triage::classify_severity
        # Missing op auth > missing direnv > missing key > stale key
        # Last stage -- emits confidence for route_on_confidence

  - route_on_confidence: action
    value: "{{ steps.diagnose.confidence }}"
    routes:
      - range: "[0.0, 0.4)"
        label: broken
        handler: ctrl::log
        # Chain is broken -- op not authed or direnv not loaded
      - range: "[0.4, 0.8)"
        label: degraded
        handler: ctrl::log
        # Partial resolution -- some keys missing or stale
      - range: "[0.8, 1.0]"
        label: healthy
        handler: ctrl::log
        # Full chain resolves correctly -- no action needed
